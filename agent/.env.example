# Required — deployer private key (0x-prefixed)
# This wallet is the owner of TeamTokenFactory, FantasyLeague, MatchPredictor
DEPLOYER_PRIVKEY=0x...

# Optional — for posting AI commentary to X/Twitter
# Requires a Developer App with "Write" permissions and OAuth 2.0
TWITTER_BEARER_TOKEN=

# Optional — Anthropic API key for AI commentary
# Defaults to ANTHROPIC_API_KEY if set in shell
ANTHROPIC_API_KEY=sk-ant-...
