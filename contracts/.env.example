# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Deployer private key (with 0x prefix)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# XLayer RPC endpoints
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# OKLink API Key — for contract verification on https://www.oklink.com/xlayer
OKLINK_API_KEY=your_oklink_api_key

# ─── Required for deployment ──────────────────────────────────────────────────

# DEX Router — PotatoSwap V2 (dominant DEX on XLayer, 27k+ pairs, Flap graduation target)
# Mainnet: 0x881fB2f98c13d521009464e7D1CBf16E1b394e8E
# Testnet: 0x8c3ceaBeBc63294704Eca5E6Db025C7495A3Fac1  (XLayerSwap — testnet only)
DEX_ROUTER_ADDRESS=0x881fB2f98c13d521009464e7D1CBf16E1b394e8E

# Wrapped OKB — intermediate hop in buyback paths (TeamToken → WOKB → XLWC)
# Same address on mainnet and testnet
WOKB_ADDRESS=0xe538905cf8410324e03a5a23c1c177a474d59b2b

# ─── Optional ────────────────────────────────────────────────────────────────

# If XLWC was launched via Flap.sh, set this to skip WorldCupToken deployment.
# XLWC_ADDRESS=0xYOUR_FLAP_XLWC_ADDRESS
